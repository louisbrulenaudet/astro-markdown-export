{
  "name": "@louisbrulenaudet/astro-markdown-export",
  "description": "Enables content negotiation for your blog directly from Astro to make what truly matters available to AI agents 🪵",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisbrulenaudet/astro-markdown-export.git"
  },
  "homepage": "https://github.com/louisbrulenaudet/astro-markdown-export#readme",
  "files": [
    "dist"
  ],
  "keywords": [
    "astro-integration",
    "withastro",
    "markdown",
    "export",
    "content",
    "tooling",
    "astro-markdown-export",
    "cloudflare-workers",
    "content-negotiation",
    "ai-agents",
    "generative-ai",
    "geo",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir dist",
    "test": "vitest",
    "test:run": "vitest run",
    "check-types": "tsc --noEmit",
    "format": "pnpm exec biome format . --write",
    "lint": "pnpm exec biome lint . --write",
    "check": "pnpm exec biome check . --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^22.0.0",
    "astro": "^6.0.4",
    "tsdown": "^0.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0"
  },
  "packageManager": "pnpm@10.32.0"
}
